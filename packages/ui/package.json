{
  "name": "@sangisalarp/ui",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Playful neo-brutalist React component kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deserveto/doodle-ds.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/deserveto/doodle-ds/issues"
  },
  "homepage": "https://github.com/deserveto/doodle-ds#readme",
  "sideEffects": ["./dist/*.css"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -i src/styles/index.css -o dist/index.css --minify && tailwindcss -i src/styles/theme.css -o dist/theme.css --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sangisalarp/icons": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.2",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3"
  }
}
