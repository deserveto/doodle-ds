{
  "name": "@sangisalarp/icons",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Scribbles — wobbly hand-drawn icon set for Doodle DS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deserveto/doodle-ds.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/deserveto/doodle-ds/issues"
  },
  "homepage": "https://github.com/deserveto/doodle-ds#readme",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svg/*": "./dist/svg/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.14",
    "react": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3"
  }
}
